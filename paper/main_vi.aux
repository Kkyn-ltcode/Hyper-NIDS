\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Chronological shard structure and cross-campaign evaluation splits. Each rectangle represents one data shard. \textbf  {Theia} (top): the model trains on Campaign~1 (shards 0--8) and is tested entirely on the unseen Campaign~2 (shards 12--24), separated by a 92-hour gap. \textbf  {CADETS} (middle): 10 shards with attacks concentrated in later shards. \textbf  {TRACE} (bottom): 50 strategically selected shards from 211 total ($\sim $200M of 835M events); dots mark selected shards. Small red bars indicate shards containing attack events. All splits are strictly chronological to prevent temporal data leakage.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:timeline}{{3}{12}{Chronological shard structure and cross-campaign evaluation splits. Each rectangle represents one data shard. \textbf {Theia} (top): the model trains on Campaign~1 (shards 0--8) and is tested entirely on the unseen Campaign~2 (shards 12--24), separated by a 92-hour gap. \textbf {CADETS} (middle): 10 shards with attacks concentrated in later shards. \textbf {TRACE} (bottom): 50 strategically selected shards from 211 total ($\sim $200M of 835M events); dots mark selected shards. Small red bars indicate shards containing attack events. All splits are strictly chronological to prevent temporal data leakage}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Kết quả Chính (C4)}{12}{subsection.5.2}\protected@file@percent }
