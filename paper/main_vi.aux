\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Hiệu suất phát hiện trên DARPA TC E3. Các phương pháp cơ sở sử dụng nhãn tấn công rộng (tất cả các nút tấn công); các dòng xuyên tiến trình của HyperMamba sử dụng nhãn xuyên tiến trình (crossprocess+) nghiêm ngặt hơn (loại trừ các tiến trình điểm vào). Các dòng giao thức KAIROS và CADETS sử dụng nhãn rộng để so sánh trực tiếp. AUPRC nút 0.9987 của dòng giao thức KAIROS phản ánh tỷ lệ mẫu dương 32\% của nhãn rộng, bao gồm hành vi điểm vào dị thường vốn tương đối dễ phát hiện; các dòng xuyên tiến trình sử dụng tỷ lệ mẫu dương <1\%.}}{13}{table.1}\protected@file@percent }
\newlabel{tab:main_results}{{1}{13}{Hiệu suất phát hiện trên DARPA TC E3. Các phương pháp cơ sở sử dụng nhãn tấn công rộng (tất cả các nút tấn công); các dòng xuyên tiến trình của HyperMamba sử dụng nhãn xuyên tiến trình (crossprocess+) nghiêm ngặt hơn (loại trừ các tiến trình điểm vào). Các dòng giao thức KAIROS và CADETS sử dụng nhãn rộng để so sánh trực tiếp. AUPRC nút 0.9987 của dòng giao thức KAIROS phản ánh tỷ lệ mẫu dương 32\% của nhãn rộng, bao gồm hành vi điểm vào dị thường vốn tương đối dễ phát hiện; các dòng xuyên tiến trình sử dụng tỷ lệ mẫu dương <1\%}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Nghiên cứu Cắt bỏ: Đóng góp của các Thành phần}{13}{subsection.5.3}\protected@file@percent }
\newlabel{sec:ablation}{{5.3}{13}{Nghiên cứu Cắt bỏ: Đóng góp của các Thành phần}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Precision-Recall curves. Dots mark the F1-optimal operating point (threshold selected from validation). \textbf  {(a)}~Main results: CADETS achieves near-perfect precision across all recall levels; the Theia cross-campaign curve shows the expected performance gap from same-campaign, reflecting the difficulty of generalizing to unseen attack strategies. \textbf  {(b)}~Ablation study: removing process identity (red dashed) causes the curve to collapse below 0.35 precision at all operating points; removing both state and process (gray dotted) yields a near-flat curve indistinguishable from random, confirming that crossprocess attack events cannot be detected from isolated event features alone.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:pr_curves}{{4}{14}{Precision-Recall curves. Dots mark the F1-optimal operating point (threshold selected from validation). \textbf {(a)}~Main results: CADETS achieves near-perfect precision across all recall levels; the Theia cross-campaign curve shows the expected performance gap from same-campaign, reflecting the difficulty of generalizing to unseen attack strategies. \textbf {(b)}~Ablation study: removing process identity (red dashed) causes the curve to collapse below 0.35 precision at all operating points; removing both state and process (gray dotted) yields a near-flat curve indistinguishable from random, confirming that crossprocess attack events cannot be detected from isolated event features alone}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Nghiên cứu cắt bỏ thành phần (phân chia chéo chiến dịch, nhãn xuyên tiến trình). Mỗi dòng loại bỏ một hoặc nhiều thành phần khỏi mô hình đầy đủ. $\Delta $ là sự thay đổi tương đối của AUPRC sự kiện.}}{14}{table.2}\protected@file@percent }
\newlabel{tab:ablation_unified}{{2}{14}{Nghiên cứu cắt bỏ thành phần (phân chia chéo chiến dịch, nhãn xuyên tiến trình). Mỗi dòng loại bỏ một hoặc nhiều thành phần khỏi mô hình đầy đủ. $\Delta $ là sự thay đổi tương đối của AUPRC sự kiện}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Component ablation on the cross-campaign split with the crossprocess label. The dashed line marks the full model's event AUPRC (0.76). Process identity is the dominant contributor ($-55\%$); removing both state and process identity collapses detection to near-random (0.20).}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:ablation}{{5}{14}{Component ablation on the cross-campaign split with the crossprocess label. The dashed line marks the full model's event AUPRC (0.76). Process identity is the dominant contributor ($-55\%$); removing both state and process identity collapses detection to near-random (0.20)}{figure.5}{}}
